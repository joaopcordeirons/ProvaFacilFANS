# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA suba o .env de verdade para o Git (já está no .gitignore).

PORT=80

# Login/cadastro/recuperação de senha (auth.js + authMiddleware.js).
# Chave usada para assinar o cookie de sessão (JWT). OBRIGATÓRIA — sem
# ela o login não funciona. Gere uma string aleatória longa, por
# exemplo com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-uma-string-aleatoria-bem-grande

# E-mail do Gmail que vai receber as questões dos professores.
# A mesma conta é usada para ENVIAR o link de recuperação de senha
# (login.html -> "Esqueci minha senha"). Sem GMAIL_USER/GMAIL_APP_PASSWORD
# configurados, o link de recuperação só aparece no log do servidor
# (bom para testar localmente, mas configure em produção).
GMAIL_USER=seuprojeto@gmail.com

# Senha de app do Google (NÃO é a senha normal da conta).
# Gere em: https://myaccount.google.com/apppasswords
# (exige verificação em duas etapas ativada na conta)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Firebase / Cloud Firestore (use uma das opções abaixo)
# Opção recomendada para Vercel: JSON da conta de serviço em uma única linha.
# FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}

# Alternativa: separar os campos da conta de serviço.
# FIREBASE_PROJECT_ID=seu-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Correção ortográfica/gramatical automática (LanguageTool). Opcional:
# por padrão já usa a API pública gratuita deles, não precisa configurar
# nada. Só preencha se for auto-hospedar o LanguageTool (ex.: via Docker)
# pra fugir do limite de requisições da API pública em uso muito grande.
# LANGUAGETOOL_URL=https://seu-languagetool-autohospedado.com/v2/check

# Verificação opcional de COERÊNCIA de conteúdo por IA (botão "Verificar
# conteúdo com IA", sob demanda — nunca roda automático). Usa a API
# gratuita do Gemini (sem cartão de crédito). Gere sua chave grátis em:
# https://aistudio.google.com/apikey
# Sem essa chave, o resto do sistema funciona normalmente — só esse
# botão fica indisponível.
# GEMINI_API_KEY=sua-chave-gratuita-do-google-ai-studio
# GEMINI_MODEL=gemini-flash-latest
